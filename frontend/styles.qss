/* ============================================
   SAN GIORGIO — Restaurant Theme
   Palette (charte logo) :
     - Fond sombre      : #1A1714
     - Bordeaux (CTA)   : #7A1E1C, hover #963433, pressed #5F1616
     - Doré (typo)      : #D4A365 / #B88647
     - Crème (texte)    : #F5F1E6
     - Vert (validé)    : #2D6B45
   ============================================ */

/* --- Global --- */
QMainWindow, QWidget {
    background-color: #1A1714;
    color: #F5F1E6;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

/* --- Labels --- */
QLabel {
    color: #F5F1E6;
    background: transparent;
    padding: 2px;
}

QLabel#page-title {
    font-family: "Segoe UI", sans-serif;
    font-size: 26px;
    font-weight: bold;
    color: #D4A365;
    padding: 8px 0;
    letter-spacing: 1px;
}

QLabel#page-subtitle {
    font-size: 13px;
    color: #A09888;
    padding: 0 0 8px 0;
}

QLabel#brand-title {
    font-family: "Segoe UI", sans-serif;
    font-size: 48px;
    font-weight: bold;
    color: #D4A365;
    letter-spacing: 3px;
}

QLabel#brand-subtitle {
    font-family: "Segoe UI", sans-serif;
    font-size: 16px;
    color: #A09888;
    letter-spacing: 2px;
}

QLabel#cart-total {
    font-family: "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: bold;
    color: #D4A365;
    padding: 12px 16px;
    background-color: #252220;
    border-radius: 8px;
    border: 1px solid #3A3530;
}

QLabel#order-info {
    font-size: 14px;
    font-weight: bold;
    color: #B88647;
    padding: 8px 12px;
    background-color: #252220;
    border-radius: 6px;
    border-left: 3px solid #B88647;
}

QLabel#section-header {
    font-family: "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: #D4A365;
    padding: 6px 0;
    border-bottom: 1px solid #3A3530;
}

/* --- Standard Buttons --- */
QPushButton {
    background-color: #7A1E1C;
    color: #F5F1E6;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #963433;
}

QPushButton:pressed {
    background-color: #5F1616;
}

QPushButton:disabled {
    background-color: #4A4540;
    color: #7A7570;
}

/* --- Button variants via objectName --- */
QPushButton#btn-primary {
    background-color: #7A1E1C;
    font-size: 16px;
    padding: 14px 28px;
    border-radius: 8px;
}

QPushButton#btn-primary:hover {
    background-color: #963433;
}

QPushButton#btn-danger {
    background-color: #9C2A24;
}

QPushButton#btn-danger:hover {
    background-color: #B83A34;
}

QPushButton#btn-danger:pressed {
    background-color: #7D211C;
}

QPushButton#btn-success {
    background-color: #2D6B45;
}

QPushButton#btn-success:hover {
    background-color: #38835A;
}

QPushButton#btn-success:pressed {
    background-color: #245838;
}

QPushButton#btn-kitchen {
    background-color: #2D6B45;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: 8px;
    letter-spacing: 1px;
}

QPushButton#btn-kitchen:hover {
    background-color: #38835A;
}

QPushButton#btn-kitchen:pressed {
    background-color: #245838;
}

QPushButton#btn-invoice {
    background-color: #2D6B45;
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton#btn-invoice:hover {
    background-color: #38835A;
}

QPushButton#btn-cancel-order {
    background-color: #9C2A24;
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 8px;
}

QPushButton#btn-cancel-order:hover {
    background-color: #B83A34;
}

QPushButton#btn-secondary {
    background-color: #3A3530;
    color: #C0B8A8;
    border: 1px solid #4A4540;
}

QPushButton#btn-secondary:hover {
    background-color: #4A4540;
    color: #F5F1E6;
}

QPushButton#btn-nav {
    background-color: transparent;
    color: #A09888;
    border: 1px solid #3A3530;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton#btn-nav:hover {
    background-color: #2D2824;
    color: #D4A365;
    border-color: #B88647;
}

/* Menu card buttons */
QPushButton#menu-card {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 12px;
    padding: 20px;
    font-size: 15px;
    font-weight: bold;
    text-align: center;
}

QPushButton#menu-card:hover {
    background-color: #2D2824;
    border-color: #B88647;
    color: #D4A365;
}

QPushButton#menu-card:pressed {
    background-color: #1A1714;
    border-color: #D4A365;
}

QPushButton#menu-card-primary {
    background-color: #352A1E;
    color: #D4A365;
    border: 2px solid #B88647;
    border-radius: 12px;
    padding: 20px;
    font-size: 17px;
    font-weight: bold;
    text-align: center;
}

QPushButton#menu-card-primary:hover {
    background-color: #3D321F;
    border-color: #D4A365;
}

QPushButton#menu-card-primary:pressed {
    background-color: #2A2015;
    border-color: #D4A365;
}

/* --- Table Widgets --- */
QTableWidget {
    background-color: #1E1C19;
    alternate-background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 6px;
    gridline-color: #2D2824;
    selection-background-color: #3D321F;
    selection-color: #D4A365;
    font-size: 13px;
}

QTableWidget::item {
    padding: 4px 12px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #3D321F;
    color: #D4A365;
}

QTableWidget::item:hover {
    background-color: #2D2824;
}

QTableWidget::item:focus {
    border: none;
    outline: none;
}

QHeaderView::section {
    background-color: #252220;
    color: #B88647;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #B88647;
    font-weight: bold;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background-color: #2D2824;
}

/* --- Tree Widgets --- */
QTreeWidget {
    background-color: #1E1C19;
    alternate-background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
}

QTreeWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #2D2824;
    min-height: 28px;
}

QTreeWidget::item:selected {
    background-color: #3D321F;
    color: #D4A365;
}

QTreeWidget::item:hover {
    background-color: #2D2824;
}

QTreeWidget::branch {
    background: transparent;
}

/* --- ComboBox --- */
QComboBox {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 24px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #B88647;
}

QComboBox:focus {
    border-color: #D4A365;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    selection-background-color: #3D321F;
    selection-color: #D4A365;
}

/* --- SpinBox --- */
QSpinBox {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 24px;
    font-size: 14px;
}

QSpinBox:hover {
    border-color: #B88647;
}

QSpinBox:focus {
    border-color: #D4A365;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #3A3530;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #B88647;
}

/* --- TimeEdit / DateEdit --- */
QTimeEdit, QDateEdit, QDoubleSpinBox {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 24px;
    font-size: 14px;
}

QTimeEdit:hover, QDateEdit:hover, QDoubleSpinBox:hover {
    border-color: #B88647;
}

QTimeEdit:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    border-color: #D4A365;
}

QTimeEdit::up-button, QTimeEdit::down-button,
QDateEdit::up-button, QDateEdit::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #3A3530;
    border: none;
    width: 20px;
}

QTimeEdit::up-button:hover, QTimeEdit::down-button:hover,
QDateEdit::up-button:hover, QDateEdit::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #B88647;
}

/* --- Scrollbar --- */
QScrollBar:vertical {
    background: #1E1C19;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3A3530;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #B88647;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1E1C19;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3A3530;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #B88647;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Scroll Area --- */
QScrollArea {
    border: none;
    background: transparent;
}

/* --- Dialog --- */
QDialog {
    background-color: #1E1C19;
    color: #F5F1E6;
    border: 1px solid #3A3530;
}

/* --- MessageBox --- */
QMessageBox {
    background-color: #1E1C19;
    color: #F5F1E6;
}

QMessageBox QLabel {
    color: #F5F1E6;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 20px;
}

/* --- Input --- */
QLineEdit {
    background-color: #252220;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: #B88647;
}

QLineEdit:hover {
    border-color: #B88647;
}

QLineEdit:focus {
    border-color: #D4A365;
    background-color: #2D2824;
}

/* --- InputDialog --- */
QInputDialog {
    background-color: #1E1C19;
}

/* --- Menu (context menus, dropdowns) --- */
QMenu {
    background-color: #2C2520;
    color: #F5F1E6;
    border: 1px solid #3E3530;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 20px 7px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #B88647;
    color: #1A1510;
}

QMenu::separator {
    height: 1px;
    background-color: #3A3530;
    margin: 4px 6px;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #2D2824;
    color: #F5F1E6;
    border: 1px solid #B88647;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* --- Frame separator --- */
QFrame#separator {
    background-color: #3A3530;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* --- Utility text labels --- */
QLabel#text-muted {
    color: #A09888;
    font-size: 12px;
    background: transparent;
}

QLabel#text-dim {
    color: #6A6255;
    font-size: 13px;
    background: transparent;
}

QLabel#text-faint {
    color: #5A5550;
    font-size: 12px;
    background: transparent;
}

QLabel#stock-warn {
    color: #E74C3C;
    font-size: 11px;
    background: transparent;
}

QLabel#stock-ok {
    color: #6A6255;
    font-size: 11px;
    background: transparent;
}

QLabel#batch-header {
    color: #D4A365;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
    padding: 4px 0;
}

/* --- Info panel (grouped info card) --- */
QFrame#info-panel {
    background: #2A2620;
    border: 1px solid #3A3530;
    border-radius: 6px;
}

/* --- Filter bar --- */
QFrame#filter-bar {
    background: #2A2620;
    border: 1px solid #3A3530;
    border-radius: 4px;
}

QFrame#filter-bar QLabel,
QFrame#filter-bar QLineEdit,
QFrame#filter-bar QDateEdit,
QFrame#filter-bar QDoubleSpinBox,
QFrame#filter-bar QComboBox,
QFrame#filter-bar QPushButton {
    font-size: 11px;
}

/* --- Option row (option picker dialog) --- */
QWidget#option-row {
    background-color: #252220;
    border-radius: 6px;
    padding: 4px;
}

QLabel#option-name {
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

/* --- Flat icon button (transparent, hover subtle bg) --- */
QPushButton#btn-icon {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
    min-width: 0;
    font-weight: normal;
}

QPushButton#btn-icon:hover {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

QPushButton#btn-icon:pressed {
    background: rgba(255, 255, 255, 0.14);
}

/* Bordered variant of btn-icon (e.g. top-right menu trigger) */
QPushButton#btn-icon-bordered {
    background: transparent;
    border: 1px solid #3E3530;
    border-radius: 4px;
    padding: 0;
    min-height: 0;
    min-width: 0;
    font-weight: normal;
}

QPushButton#btn-icon-bordered:hover {
    background: rgba(255, 255, 255, 0.08);
}

QPushButton#btn-icon-bordered:pressed {
    background: rgba(255, 255, 255, 0.14);
}

/* --- Category list (POS) --- */
QTableWidget#cat-table {
    background-color: #1E1C19;
    border: 1px solid #3A3530;
    border-radius: 8px;
    outline: none;
}

QTableWidget#cat-table::item {
    padding: 12px 16px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

QTableWidget#cat-table::item:selected {
    background-color: #352A1E;
    color: #D4A365;
    border: none;
}

QTableWidget#cat-table::item:focus {
    border: none;
    outline: none;
}

/* --- Items table (POS) --- */
QTableWidget#items-table {
    background-color: #1E1C19;
    border: 1px solid #3A3530;
    border-radius: 8px;
}

QTableWidget#items-table::item {
    padding: 10px 12px;
}

/* --- Cart table --- */
QTableWidget#cart-table {
    background-color: #252220;
    border: 1px solid #3A3530;
    border-radius: 8px;
}

QTableWidget#cart-table::item {
    padding: 8px 10px;
    font-size: 13px;
}

/* --- Cart row widgets (spin + action buttons) --- */
QSpinBox#cart-qty {
    background-color: #1A1714;
    color: #F5F1E6;
    border: 1px solid #3A3530;
    border-radius: 3px;
    padding: 4px 6px;
    min-height: 24px;
    font-size: 14px;
    font-weight: bold;
}

QSpinBox#cart-qty:hover {
    border-color: #B88647;
}

QSpinBox#cart-qty::up-button,
QSpinBox#cart-qty::down-button {
    background-color: #3A3530;
    border: none;
    width: 20px;
}

QSpinBox#cart-qty::up-button:hover,
QSpinBox#cart-qty::down-button:hover {
    background-color: #B88647;
}

QPushButton#btn-cart-edit {
    background-color: transparent;
    color: #D4A365;
    border: none;
    padding: 0;
    font-size: 14px;
    min-height: 0;
    font-weight: normal;
}

QPushButton#btn-cart-edit:hover {
    background-color: #2D2824;
    color: #F5F1E6;
    border-radius: 4px;
}

QPushButton#btn-cart-remove {
    background-color: transparent;
    color: #C0392B;
    border: none;
    padding: 0;
    font-size: 14px;
    min-height: 0;
    font-weight: normal;
}

QPushButton#btn-cart-remove:hover {
    background-color: #2D2824;
    color: #E74C3C;
    border-radius: 4px;
}

/* --- Dialog section header (small bold label) --- */
QLabel#dialog-section {
    color: #B88647;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 0 2px 0;
    letter-spacing: 0.5px;
}

/* --- Ingredient tag list (item edit dialog) --- */
QListWidget#ingredient-tags {
    background-color: #1A1714;
    border: 1px solid #3A3530;
    border-radius: 4px;
    color: #F5F1E6;
    font-size: 13px;
    padding: 4px;
}

QListWidget#ingredient-tags::item {
    padding: 4px 8px;
    border-bottom: 1px solid #2D2824;
}

QListWidget#ingredient-tags::item:selected {
    background-color: #3D321F;
    color: #D4A365;
}

/* --- CheckBox / RadioButton (dialogs) --- */
QCheckBox, QRadioButton {
    color: #F5F1E6;
    background: transparent;
    spacing: 8px;
    padding: 2px;
    font-size: 13px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #252220;
    border: 1px solid #3A3530;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #B88647;
}

QCheckBox::indicator:checked {
    background-color: #B88647;
    border-color: #B88647;
    image: none;
}

QRadioButton::indicator:checked {
    background-color: #252220;
    border: 5px solid #B88647;
}
